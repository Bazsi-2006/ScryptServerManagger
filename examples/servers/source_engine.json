{
  "id": "source_engine",
  "name": "Source engine server",
  "description": "Forking server tracked through its PID file. Readiness uses a UDP probe: the A2S_INFO query, which the server answers once it is up.",
  "category": "source",
  "backend": "custom",
  "working_dir": "/opt/srcds",
  "custom": {
    "mode": "forking",
    "start": { "command": "/opt/srcds/start.sh" },
    "pid_file": "/opt/srcds/srcds.pid",
    "stop_signal": "SIGTERM",
    "kill_on_timeout": true
  },
  "readiness": {
    "method": "port",
    "port": {
      "host": "127.0.0.1",
      "port": 27015,
      "protocol": "udp",
      "timeout": "2s",
      "udp_payload_hex": "ffffffff54536f7572636520456e67696e6520517565727900"
    },
    "interval": "3s"
  },
  "timeouts": { "start": "3m", "stop": "30s" }
}
