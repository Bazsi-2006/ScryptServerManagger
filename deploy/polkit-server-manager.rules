// /etc/polkit-1/rules.d/50-server-manager.rules
//
// Alternative to sudo: allow the service user to start, stop and restart
// specific systemd units directly ("use_sudo": false). Requires polkit >= 0.106
// (JavaScript rules). List the units explicitly.

polkit.addRule(function (action, subject) {
    var allowedUnits = ["minecraft.service", "valheim.service"];
    var allowedVerbs = ["start", "stop", "restart"];

    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "server-manager" &&
        allowedUnits.indexOf(action.lookup("unit")) >= 0 &&
        allowedVerbs.indexOf(action.lookup("verb")) >= 0) {
        return polkit.Result.YES;
    }
});
