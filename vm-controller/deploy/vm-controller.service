# systemd unit for vm-controller.
#
# Install:
#   sudo install -m 0644 deploy/vm-controller.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now vm-controller
#
# Expects:
#   /usr/local/bin/vm-controller             the binary (root:root 0755)
#   /etc/vm-controller/config.json           configuration (root:vm-controller 0640)
#   /etc/vm-controller/vexa-api-key          Vexa API key (root:vm-controller 0640),
#                                            referenced by "vexa.api_key_file"
#   /var/lib/vm-controller/                  created by StateDirectory= below
#
# Check the hardening of the running unit with:
#   systemd-analyze security vm-controller

[Unit]
Description=VM Controller (start/stop web UI for Vexa-VM)
Documentation=file:///usr/local/share/doc/vm-controller/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vm-controller
Group=vm-controller
ExecStart=/usr/local/bin/vm-controller serve --config /etc/vm-controller/config.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s

# The SQLite database lives in /var/lib/vm-controller (mode 0700).
StateDirectory=vm-controller
StateDirectoryMode=0700
UMask=0077

# Alternative to api_key_file: put VEXA_API_KEY=... in a root-only file and
# set "api_key_env": "VEXA_API_KEY" in config.json.
#EnvironmentFile=/etc/vm-controller/vm-controller.env

# ---- hardening ----
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
DevicePolicy=closed
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

# Resource limits. Each login hashes with 64 MiB of memory and at most two
# hashes run at once.
MemoryMax=512M
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
